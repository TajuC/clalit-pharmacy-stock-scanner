# Required medicine name exactly/partially as it appears in autocomplete
MEDICINE_QUERY=VYVANSE 30MG

# API language parameter
APP_LANG=he-il

# Page URL
TARGET_URL=https://e-services.clalit.co.il/PharmacyStock/

# Max parallel city checks per browser context (higher is faster, too high may be blocked)
CONCURRENCY=4

# Optional hard limit for city checks (0 = no limit)
MAX_CITIES=0

# Browser options
HEADLESS=true
SLOW_MO=0
TIMEOUT_MS=25000

# Retries per city on transient failures
RETRIES=2
