# Required medicine name exactly/partially as it appears in autocomplete
MEDICINE_QUERY=VYVANSE 30MG

# API language parameter
APP_LANG=he-il

# Page URL
TARGET_URL=https://e-services.clalit.co.il/PharmacyStock/

# Max parallel city checks
CONCURRENCY=2

# Minimum gap between verified stock requests; the service rejects bursts
REQUEST_INTERVAL_MS=1500

# Stop when the service accepts nothing for this many minutes
STALL_MINUTES=5

# Recheck cities without pharmacies after this many days
INDEX_MAX_AGE_DAYS=30

# Optional hard limit for city checks (0 = no limit)
MAX_CITIES=0

# Browser options. Chrome or Edge is detected automatically; set BROWSER_PATH to override.
# The service rejects headless browsers, so the window always exists; SHOW_BROWSER=false keeps it minimized.
BROWSER_PATH=
SHOW_BROWSER=false
SLOW_MO=0
TIMEOUT_MS=25000

# Retries per city on transient failures
RETRIES=2
